[URL Rewrite]
# Pangolin: block ad/config/material fetches, not telemetry batches.
^https?:\/\/api-access\.pangolin-sdk-toutiao(?:\d+|-b)?\.com\/api\/ad\/union\/sdk\/get_ads\/ - reject-dict
^https?:\/\/api-access\.pangolin-sdk-toutiao(?:\d+|-b)?\.com\/api\/ad\/union\/sdk\/settings\/ - reject-dict
^https?:\/\/api\.pangolin-sdk-toutiao(?:\d+|-b)?\.com\/api\/ad\/union\/sdk\/get_ads\/ - reject-dict
^https?:\/\/api\.pangolin-sdk-toutiao(?:\d+|-b)?\.com\/api\/ad\/union\/sdk\/settings\/ - reject-dict
^https?:\/\/gromore\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/mediation\/(?:config|exchange)\/ - reject-dict
^https?:\/\/ether-pack\.pangolin-sdk-toutiao\.com\/union\/endcard\/ - reject-200
^https?:\/\/sf\d+-fe-tos\.pglstatp-toutiao\.com\/obj\/ad-pattern\/ - reject-200

# GDT: block ad view/click payloads without rejecting the whole SDK domain.
^https?:\/\/(?:mi|v2mi|win)\.gdt\.qq\.com\/gdt_(?:mview|view|click)\.fcg - reject-dict

# High-confidence application ad endpoints.
^https?:\/\/mobads\.baidu\.com\/.* - reject-dict
^https?:\/\/afd\.baidu\.com\/afd\/entry - reject-dict
^https?:\/\/optimus-ads\.amap\.com\/ - reject-200
^https?:\/\/m\d\.amap\.com\/ws\/valueadded\/alimama\/splash_screen - reject-200
^https?:\/\/amap-aos-info-nogw\.amap\.com\/ws\/aos\/alimama\/ - reject-200
^https?:\/\/images\.pinduoduo\.com\/marketing_api - reject-200
^https?:\/\/router-app-api\.jdcloud\.com\/v\d\/board\/routerAppSplash - reject-200
^https?:\/\/ad\.12306\.cn\/ad\/ser\/getAdList$ - reject-dict
^https?:\/\/api\.chelaile\.net\.cn\/(?:adpub|goocity\/advert) - reject-dict
^https?:\/\/web\.chelaile\.net\.cn\/api\/adpub - reject-dict
^https?:\/\/app-gw\.csdn\.net\/cms-app\/v\d\/home_page\/open_advertisement - reject-dict
^https?:\/\/gab\.122\.gov\.cn\/eapp\/m\/sysquery\/adver$ - reject-dict
^https?:\/\/ssp\.soulapp\.cn\/api\/q\? - reject-dict
^https?:\/\/fuss10\.elemecdn\.com\/.+\.mp4 - reject-200

[Script]
AdBlock_Bilibili_Clean = type=http-response,requires-body=1,max-size=3145728,script-path=https://raw.githubusercontent.com/lok347/shadowrocket-adblock/main/scripts/adblock-clean.js,pattern=^https?:\/\/(?:app\.bili(?:bili\.com|api\.net)\/x\/(?:v2\/splash|v2\/feed\/index|resource\/show\/tab|resource\/patch\/tab|v2\/search|v2\/account\/mine)|api\.bilibili\.com\/x\/web-interface\/wbi\/index\/top\/feed\/rcmd|api\.vc\.bilibili\.com\/dynamic_svr\/v1\/dynamic_svr\/dynamic_)
