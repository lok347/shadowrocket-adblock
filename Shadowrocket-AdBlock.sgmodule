#!name=AdBlock_lok.20261023
#!desc=Layered blocking: DIRECT guards -> AWAvenue RULE-SET -> static fallback -> precise rewrites -> allowlisted cleaning. +62 reviewed domain rules (2026-10-23); untested on iOS.
#!author=Y123456-hzy (upstream); lok347 (maintenance)
#!homepage=https://github.com/lok347/shadowrocket-adblock
#!system=ios
# Upstream: https://gist.github.com/Y123456-hzy/dd342a1a61daf8c250b112faa1381918

[General]
always-reject-url-rewrite = false
force-http-engine-hosts = %APPEND% app.bilibili.com,app.biliapi.net,api.bilibili.com,api.vc.bilibili.com,acs.m.taobao.com,guide-acs.m.taobao.com,acs.m.goofish.com,poplayer.template.alibaba.com,api.m.jd.com,api.yangkeduo.com,api.pinduoduo.com,api.zhihu.com,web-render.zhihu.com,wmapi.meituan.com,api.xueqiu.com,api.mcd.cn,res.kfc.com.cn,dynamicad.kfc.com.cn,m5.amap.com,newclient.map.baidu.com,app.58.com,api-access.pangolin-sdk-toutiao.com,api-access.pangolin-sdk-toutiao1.com,api-access.pangolin-sdk-toutiao-b.com,api.pangolin-sdk-toutiao.com,api.pangolin-sdk-toutiao1.com,api.pangolin-sdk-toutiao-b.com,gromore.pangolin-sdk-toutiao.com,ether-pack.pangolin-sdk-toutiao.com,sf3-fe-tos.pglstatp-toutiao.com,sf6-fe-tos.pglstatp-toutiao.com,mi.gdt.qq.com,v2mi.gdt.qq.com,win.gdt.qq.com,mobads.baidu.com,afd.baidu.com,optimus-ads.amap.com,amap-aos-info-nogw.amap.com,images.pinduoduo.com,router-app-api.jdcloud.com,ad.12306.cn,api.chelaile.net.cn,web.chelaile.net.cn,app-gw.csdn.net,gab.122.gov.cn,ssp.soulapp.cn,fuss10.elemecdn.com

[Rule]
# --- Layer 1: DIRECT guards (must stay first; first match wins). ---
# Coolapk SDK handshakes, config and telemetry must not be domain-rejected,
# otherwise the SDKs retry-storm and freeze the app. Ad payload fetches on
# these domains are still blocked by the precise URL Rewrites below.
DOMAIN-SUFFIX,gdt.qq.com,DIRECT
DOMAIN-SUFFIX,e.qq.com,DIRECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,DIRECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,DIRECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao2.com,DIRECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao3.com,DIRECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao4.com,DIRECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao5.com,DIRECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,DIRECT
DOMAIN-SUFFIX,umeng.com,DIRECT
DOMAIN-SUFFIX,umengcloud.com,DIRECT
DOMAIN,umengacs.m.taobao.com,DIRECT
DOMAIN,umengjmacs.m.taobao.com,DIRECT
DOMAIN,adashbc.ut.taobao.com,DIRECT
DOMAIN,adashxgc.ut.taobao.com,DIRECT
# Coolapk startup dependencies rejected by AWAvenue.
# Rejecting Baichuan correlates with stalling before /v6/main/init.
DOMAIN,baichuan-sdk.alicdn.com,DIRECT
DOMAIN,ios.bugly.qq.com,DIRECT
DOMAIN,mazu.m.qq.com,DIRECT
DOMAIN,tmfmazu.m.qq.com,DIRECT
# Bytedance TNC config service: required by Pangle SDK startup.
# v6.1: device log showed AWAvenue also rejects TNC on snssdk.com /
# bytedance.com / toutiaoapi.com, so guard all four domain families.
DOMAIN,tnc0-aliec2.zijieapi.com,DIRECT
DOMAIN,tnc0-alisc1.zijieapi.com,DIRECT
DOMAIN,tnc0-bjlgy.zijieapi.com,DIRECT
DOMAIN,tnc3-aliec2.zijieapi.com,DIRECT
DOMAIN,tnc3-alisc1.zijieapi.com,DIRECT
DOMAIN,tnc3-alisc2.zijieapi.com,DIRECT
DOMAIN,tnc3-bjlgy.zijieapi.com,DIRECT
DOMAIN,tnc3-aliec1.toutiaoapi.com,DIRECT
DOMAIN,tnc3-aliec2.toutiaoapi.com,DIRECT
DOMAIN,tnc3-alisc1.toutiaoapi.com,DIRECT
DOMAIN,tnc3-bjlgy.toutiaoapi.com,DIRECT
DOMAIN,tnc3-aliec2.snssdk.com,DIRECT
DOMAIN,tnc3-alisc1.snssdk.com,DIRECT
DOMAIN,tnc3-bjlgy.snssdk.com,DIRECT
DOMAIN,tnc3-aliec2.bytedance.com,DIRECT
DOMAIN,tnc3-alisc1.bytedance.com,DIRECT
DOMAIN,tnc3-bjlgy.bytedance.com,DIRECT

# --- Layer 2: maintained community rule-set (TG-Twilight/AWAvenue-Ads-Rule). ---
# 900+ ad/tracking domains, continuously updated upstream. Guards above
# shield the Coolapk-sensitive SDK domains from this list.
RULE-SET,https://raw.githubusercontent.com/TG-Twilight/AWAvenue-Ads-Rule/main/Filters/AWAvenue-Ads-Rule-Surge-RULE-SET.list,REJECT

# --- Layer 3: static fallback (works even if the RULE-SET fails to download). ---
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,googleadservices.com,REJECT
